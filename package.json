{
  "name": "skipper",
  "version": "0.1.0",
  "private": true,
  "description": "Issue inbox + orchestration layer on top of coding agents",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "desktop:dev": "pnpm --filter @skipper/desktop dev",
    "desktop:build": "pnpm --filter \"@skipper/web...\" --filter @skipper/sync --filter @skipper/cli build && pnpm desktop:prepare-cli-runtime && pnpm desktop:prepare-uv && pnpm --filter @skipper/desktop build",
    "desktop:prepare-cli-runtime": "node apps/desktop/build/prepare-cli-runtime.mjs",
    "desktop:prepare-uv": "node apps/desktop/build/prepare-uv.mjs",
    "desktop:package": "pnpm desktop:build && pnpm --filter @skipper/desktop package",
    "desktop:package:mac": "pnpm desktop:build && pnpm --filter @skipper/desktop package:mac",
    "desktop:package:win": "pnpm desktop:build && pnpm --filter @skipper/desktop package:win",
    "calibrate": "node scripts/build-calibrate.mjs && node scripts/dist/calibrate-confidence.cjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml}\""
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-common": "1.24.3"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty",
      "onnxruntime-node",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "turbo": "^2.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  }
}
