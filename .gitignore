# Landing page lives in its own repo (mikegazzaruso/nestbrain-landing).
# Keep the directory here for local dev + rsync deploys, but never commit it
# to the NestBrain repo.
apps/landing/

# Dependencies
node_modules/

# Build outputs
dist/
.next/
out/

# Desktop packaging: assembled CLI runtime tree (prepare-cli-runtime.mjs)
apps/desktop/build/cli-runtime/

# Desktop packaging: staged uv binaries (prepare-uv.mjs)
apps/desktop/build/uv/

# Confidence calibration harness (#314): the esbuild bundle and the full plan
# bodies stay local; the per-sample signal JSON, labels.json and report.md are
# the committable corpus.
scripts/dist/
scripts/calibration/runs/*/plans/

# Runtime data
data/raw/*
data/wiki/*
data/chromadb/*
data/settings.json
!data/raw/.gitkeep
!data/wiki/.gitkeep
!data/chromadb/.gitkeep

# Environment
.env
.env.local
.env.*.local

# OAuth client credentials — fork-specific. Copy oauth-config.example.ts.
apps/desktop/src/auth/oauth-config.ts

# Claude Code — per-issue plan handoff documents (/plan-issue → implementer)
.claude/plans/

# IDE
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Obsidian (inside wiki vault)
data/wiki/.obsidian/

# Turbo
.turbo/

# Debug
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Internal docs
ANTHROPIC.md
DESIDERATA.md
DEVELOPMENT_CONTRACT.md

# Auto-update channel key — injected at build time (CI secret / .env.local)
apps/desktop/src/update-config.ts

# Claude Code worktree isolation dir
.claude/worktrees/
